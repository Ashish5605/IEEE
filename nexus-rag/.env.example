# Copy this file to .env and fill in your key:  cp .env.example .env
# .env is gitignored — never commit a real key.

# --- LLM provider ---
# One of: groq | gemini | xai | openai | ollama
#   groq   = Groq inference   (keys start "gsk_")   <- default, what this project uses
#   gemini = Google AI Studio (keys start "AIza")
#   xai    = Grok by xAI      (keys start "xai-")
LLM_PROVIDER=groq

# Required for groq/gemini/openai/xai. Not needed for ollama (runs locally).
# Free Groq key: https://console.groq.com/keys
# The key must match LLM_PROVIDER above — a "gsk_" key needs groq, not gemini.
LLM_API_KEY=

# Model name for the chosen provider.
#   groq   -> openai/gpt-oss-120b   (accounts differ; list yours if this 404s)
#   gemini -> gemini-2.0-flash
#   openai -> gpt-4o-mini
#   xai    -> grok-2-latest
#   ollama -> llama3.1
LLM_MODEL=openai/gpt-oss-120b

# Optional: override the endpoint for any OpenAI-compatible provider
# (xAI defaults to https://api.x.ai/v1 automatically; set this only to point
# somewhere else, e.g. OpenRouter or a local vLLM server).
LLM_BASE_URL=

# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings ---
# Multilingual model, required for English/Tamil/Hindi cross-language retrieval.
# Runs locally and free; downloaded once on first run (~1GB).
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2

# --- Chunking ---
CHUNK_SIZE=250
CHUNK_OVERLAP=60

# --- Retrieval ---
TOP_K=5
RELEVANCE_THRESHOLD=0.35

# --- Conversation memory ---
MAX_HISTORY_TURNS=4

# --- Flask ---
FLASK_SECRET_KEY=change-me-in-production
FLASK_DEBUG=0
PORT=5000
